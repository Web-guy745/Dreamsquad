# Somnia network configuration
#
# All values below are optional — sensible defaults are baked into
# src/services/somniaChain.ts (Somnia public testnet). Set these only if
# you're pointing the app at a different indexer, RPC, or network.
#
# No secrets or private keys belong in this file or anywhere in the app.
# This integration stage is read-only market discovery — no wallet/signing
# key is required.

# HTTP endpoint for the Somnia markets indexer, if your deployment fetches
# market discovery data through an indexer rather than raw contract reads.
VITE_SOMNIA_INDEXER_URL=

# Somnia RPC endpoint (HTTP or WebSocket) used for the read-only public
# client. Defaults to https://dream-rpc.somnia.network (testnet) if unset.
VITE_SOMNIA_WS_RPC_URL=

# Which Somnia network to target: "testnet" (default) or "mainnet".
VITE_SOMNIA_NETWORK=testnet
